function UTILS.updateCanvasSize(sf, cf)
    if not sf or not cf or not sf:IsA("ScrollingFrame") then return end
    local total = 0
    for _, c in ipairs(cf:GetChildren()) do
        if c:IsA("GuiObject") then total = total + c.AbsoluteSize.Y end
    end
    sf.CanvasSize = UDim2.new(0, 0, 0, total + 100)
    cf.Size = UDim2.new(1, 0, 0, total + 80)
end

function UTILS.updateTabButtonsContainerSize(container)
    local total = 0
    for _, c in ipairs(container:GetChildren()) do
        if c:IsA("GuiObject") then total = total + c.AbsoluteSize.Y + 8 end
    end
    container.CanvasSize = UDim2.new(0, 0, 0, total)
end

function UTILS.joinAnotherServer()
    pcall(function()
        local rs = TeleportService:ReserveServer(game.PlaceId)
        if rs then TeleportService:TeleportToPrivateServer(game.PlaceId, rs, {player})
        else TeleportService:Teleport(game.PlaceId, player) end
    end)
end

function UTILS.rejoinServer()
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
    end)
end

