-- REMOTE EVENTS
-- ═══════════════════════════════════════════════
local REMOTE_SYSTEM = {}
function REMOTE_SYSTEM.find()
    for _, o in ipairs(ReplicatedStorage:GetDescendants()) do
        if o:IsA("RemoteEvent") then
            if o.Name == "CoinCollected" then REMOTE_EVENTS.CoinCollected = o
            elseif o.Name == "RoundStart" then REMOTE_EVENTS.RoundStart = o
            elseif o.Name == "RoundEnd" then REMOTE_EVENTS.RoundEnd = o end
        end
        if REMOTE_EVENTS.CoinCollected and REMOTE_EVENTS.RoundStart and REMOTE_EVENTS.RoundEnd then break end
    end
end

function REMOTE_SYSTEM.connect()
    if REMOTE_EVENTS.CoinCollected then
        REMOTE_EVENTS.CoinCollected.OnClientEvent:Connect(function(_, cur, max)
            if STATES.AutoFarm.Enabled then FARMING_STATS.CoinsCollected = FARMING_STATS.CoinsCollected + 1 end
            if cur == max and not STATES.AutoFarm.Resetting then
                STATES.AutoFarm.BagFull = true
                if STATES.AutoFarm.Enabled then task.spawn(FARMING.autoReset) end
            end
        end)
    end
    if REMOTE_EVENTS.RoundStart then
        REMOTE_EVENTS.RoundStart.OnClientEvent:Connect(function()
            STATES.AutoFarm.Farming = true
            STATES.AutoFarm.BagFull = false
            local hrp = UTILS.getHRP(); if hrp then STATES.AutoFarm.StartPosition = hrp.CFrame end
        end)
    end
    if REMOTE_EVENTS.RoundEnd then
        REMOTE_EVENTS.RoundEnd.OnClientEvent:Connect(function()
            STATES.AutoFarm.Farming = false
            STATES.KillAll.Enabled = false
        end)
    end
end

