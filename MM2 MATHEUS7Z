-- KILL ALL
-- ═══════════════════════════════════════════════
local KILL_ALL = {}

function KILL_ALL.getRoleFromServer(tp)
    local gpd = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if gpd and gpd:IsA("RemoteFunction") then
        local pd = gpd:InvokeServer()
        return pd and pd[tp.Name] and pd[tp.Name].Role
    end
    return nil
end

function KILL_ALL.hasKnife()
    local char = player.Character; if not char then return false end
    if char:FindFirstChild("Knife") then return true end
    local k = player.Backpack:FindFirstChild("Knife")
    if k then k.Parent = char; return true end
    return false
end

function KILL_ALL.equipKnife()
    local bp = player:FindFirstChild("Backpack")
    local char = player.Character; if not char then return false end
    local k = (bp and bp:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
    if k then
        if k.Parent ~= char then k.Parent = char end
        return true
    end
    return false
end

function KILL_ALL.getAllTargets()
    local vt = {}
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp ~= player and tp.Character then
            local role = KILL_ALL.getRoleFromServer(tp)
            local hum = tp.Character:FindFirstChild("Humanoid")
            if role and hum and hum.Health > 0 and table.find(CONFIG.VALID_TARGET_ROLES, role) then
                table.insert(vt, tp)
            end
        end
    end
    return vt
end

function KILL_ALL.killAll()
    if not STATES.KillAll.Enabled then return end
    if not KILL_ALL.equipKnife() then return end
    task.wait(0.1)
    local r = ReplicatedStorage:FindFirstChild("Remotes")
    local ke = r and r:FindFirstChild("Gameplay") and r.Gameplay:FindFirstChild("KillEvent")
    if not ke then return end
    local targets = KILL_ALL.getAllTargets()
    local myRoot = UTILS.getHRP(); if not myRoot then return end
    for _, t in ipairs(targets) do
        if not STATES.KillAll.Enabled then break end
        if t.Character and t.Character:FindFirstChild("Humanoid") and t.Character.Humanoid.Health > 0 and
           t.Character:FindFirstChild("HumanoidRootPart") then
            t.Character.HumanoidRootPart.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
            pcall(function() ke:FireServer(t.Name, Color3.new(1, 0, 0)) end)
            task.wait(STATES.KillAll.AttackDelay or 0.2)
        end
    end
end

function KILL_ALL.startLoop()
    task.spawn(function()
        while true do
            local wt = 0.1
            if STATES.KillAll.Enabled and STATES.AutoFarm.BagFull then
                if KILL_ALL.hasKnife() then KILL_ALL.killAll(); wt = 3 else wt = 1 end
            else wt = 0.5 end
            task.wait(wt)
        end
    end)
end

