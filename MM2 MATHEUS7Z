-- ═══════════════════════════════════════════════
function UTILS.showNotification(title, message, duration)
    duration = duration or 4

    local s = Instance.new("Sound")
    s.SoundId = CONFIG.NOTIFY_SOUND
    s.Volume = 0.4
    s.Parent = SoundService
    s:Play()
    Debris:AddItem(s, 3)

    if not UI_ELEMENTS.ScreenGui then
        UI_ELEMENTS.ScreenGui = UTILS.createInstance("ScreenGui", CoreGui, {
            Name = "mathrus7zGUI", ZIndexBehavior = Enum.ZIndexBehavior.Global,
            ResetOnSpawn = false, DisplayOrder = 100
        })
    end

    local function restack()
        for i, f in ipairs(ActiveNotifications) do
            if f and f.Parent then
                local ty = -105 - ((#ActiveNotifications - i) * NOTIFICATION_HEIGHT)
                TweenService:Create(f, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Position = UDim2.new(1, -300, 1, ty)
                }):Play()
            end
        end
    end

    local function removeNotif(nf)
        local idx = table.find(ActiveNotifications, nf)
        if idx then
            table.remove(ActiveNotifications, idx)
            nf:TweenPosition(UDim2.new(1, 320, nf.Position.Y.Scale, nf.Position.Y.Offset),
                "In", "Quad", 0.35, true, function()
                    nf:Destroy(); restack()
                end)
        end
    end

    if #ActiveNotifications >= 5 then
        removeNotif(ActiveNotifications[1]); task.wait(0.1)
    end

    local nf = UTILS.createWithStaticStroke("Frame", UI_ELEMENTS.ScreenGui, {
        Name = "Notification", Size = UDim2.new(0, 290, 0, 78),
        Position = UDim2.new(1, 20, 1, -105),
        BackgroundColor3 = CONFIG.PANEL_COLOR,
        BackgroundTransparency = 0.15, ZIndex = 100, ClipsDescendants = true
    })
    UTILS.createInstance("UICorner", nf, {CornerRadius = UDim.new(0, 8)})

    UTILS.createInstance("TextLabel", nf, {
        Text = title, Size = UDim2.new(1, -40, 0, 20),
        Position = UDim2.new(0, 12, 0, 6), BackgroundTransparency = 1,
        TextColor3 = CONFIG.MAIN_COLOR, TextSize = 14,
        Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 101
    })

    UTILS.createInstance("TextLabel", nf, {
        Text = message, Size = UDim2.new(1, -24, 0, 40),
        Position = UDim2.new(0, 12, 0, 26), BackgroundTransparency = 1,
        TextColor3 = CONFIG.TEXT_COLOR, TextSize = 12,
        Font = Enum.Font.Gotham, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 101
    })

    local pc = UTILS.createInstance("Frame", nf, {
        Size = UDim2.new(1, -60, 0, 2),
        Position = UDim2.new(0, 12, 1, -8),
        BackgroundColor3 = Color3.fromRGB(70, 70, 75),
        BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 102
    })
    UTILS.createInstance("UICorner", pc, {CornerRadius = UDim.new(1, 0)})

    local pb = UTILS.createInstance("Frame", pc, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = CONFIG.MAIN_COLOR, BorderSizePixel = 0, ZIndex = 103
    })
    UTILS.createInstance("UICorner", pb, {CornerRadius = UDim.new(1, 0)})

    local tt = UTILS.createInstance("TextLabel", nf, {
        Size = UDim2.new(0, 40, 0, 12),
        Position = UDim2.new(1, -50, 1, -18), BackgroundTransparency = 1,
        Text = tostring(duration) .. "s",
        TextColor3 = CONFIG.TEXT_DIM, TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 102
    })

    local cb = UTILS.createInstance("TextButton", nf, {
        Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -26, 0, 6),
        BackgroundColor3 = Color3.fromRGB(80, 80, 85), BackgroundTransparency = 0.4,
        Text = "×", TextColor3 = Color3.fromRGB(200, 200, 205),
        TextSize = 16, Font = Enum.Font.GothamBold, ZIndex = 105, AutoButtonColor = false
    })
    UTILS.createInstance("UICorner", cb, {CornerRadius = UDim.new(1, 0)})
    cb.MouseButton1Click:Connect(function()
        UTILS.playClickSound(); removeNotif(nf)
    end)

    table.insert(ActiveNotifications, nf)
    restack()

    local st = tick()
    local c1 = RunService.Heartbeat:Connect(function()
        if not nf or not nf.Parent then c1:Disconnect(); return end
        local el = tick() - st
        local rem = math.max(0, duration - el)
        pb.Size = UDim2.new(rem / duration, 0, 1, 0)
    end)
    local c2 = RunService.Heartbeat:Connect(function()
        if not nf or not nf.Parent then c2:Disconnect(); return end
        local el = tick() - st
        tt.Text = math.ceil(math.max(0, duration - el)) .. "s"
    end)
    task.delay(duration, function()
        if nf and nf.Parent then removeNotif(nf) end
        if c1 then c1:Disconnect() end
        if c2 then c2:Disconnect() end
    end)
    return nf
end

