local ESP_SYSTEM = {}
ESP_SYSTEM.ESP_STATES = { ESPName = false, MurdererName = true, SheriffName = true, HeroName = true, InnocentName = true }
ESP_SYSTEM.ESP_HIGHLIGHT_STATES = { ESPHighlight = false, ESPHighlightMurderer = true, ESPHighlightSheriff = true, ESPHighlightHero = true, ESPHighlightInnocent = true }
ESP_SYSTEM.ESP_LINE_STATES = { ESPLine = false, MurdererLine = true, SheriffLine = true, HeroLine = true, InnocentLine = true, LineThickness = 1.4, LineTransparency = 1 }
ESP_SYSTEM.ROLE_COLORS = {
    Murderer = Color3.fromRGB(255, 0, 0), Sheriff = Color3.fromRGB(0, 0, 255),
    Hero = Color3.fromRGB(255, 255, 0), Innocent = Color3.fromRGB(0, 255, 0)
}
ESP_SYSTEM.billboards = {}
ESP_SYSTEM.Camera = workspace.CurrentCamera
ESP_SYSTEM.LineDrawings = {}

local cachedRolesData = {}
local lastRoleUpdate = 0
local UPDATE_INTERVAL = 0.5
local lineConnections = {}

function ESP_SYSTEM.IsPlayerOnScreen(tp)
    if not ESP_SYSTEM.Camera then return true end
    local char = tp.Character; if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return false end
    local sp, on = ESP_SYSTEM.Camera:WorldToViewportPoint(hrp.Position)
    if on then
        local vs = ESP_SYSTEM.Camera.ViewportSize
        if sp.X >= -50 and sp.X <= vs.X + 50 and sp.Y >= -50 and sp.Y <= vs.Y + 50 then return true end
    end
    return false
end

function ESP_SYSTEM.GetRolesData()
    local ct = tick()
    if ct - lastRoleUpdate < UPDATE_INTERVAL then return cachedRolesData end
    local ok, rd = pcall(function()
        local gpd = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if gpd and gpd:IsA("RemoteFunction") then return gpd:InvokeServer() end
        return {}
    end)
    if ok and rd then cachedRolesData = rd; lastRoleUpdate = ct end
    return cachedRolesData
end

function ESP_SYSTEM.IsAlive(tp, rd)
    if not rd then return false end
    local pd = rd[tp.Name]
    return pd and not pd.Killed and not pd.Dead
end

function ESP_SYSTEM.getPlayerRole(tp, rd)
    if not rd then return nil, false end
    local pd = rd[tp.Name]; if not pd then return nil, false end
    return pd.Role, ESP_SYSTEM.IsAlive(tp, rd)
end

function ESP_SYSTEM.GetColorByRole(role, alive)
    if not alive then return Color3.fromRGB(150, 150, 150) end
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 0, 255)
    elseif role == "Hero" then return Color3.fromRGB(255, 255, 0)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

function ESP_SYSTEM.ShouldShowLine(role)
    if not ESP_SYSTEM.ESP_LINE_STATES.ESPLine then return false end
    if role == "Murderer" and ESP_SYSTEM.ESP_LINE_STATES.MurdererLine then return true
    elseif role == "Sheriff" and ESP_SYSTEM.ESP_LINE_STATES.SheriffLine then return true
    elseif role == "Hero" and ESP_SYSTEM.ESP_LINE_STATES.HeroLine then return true
    elseif role == "Innocent" and ESP_SYSTEM.ESP_LINE_STATES.InnocentLine then return true end
    return false
end

function ESP_SYSTEM.RemoveLineForPlayer(name)
    if ESP_SYSTEM.LineDrawings[name] then
        ESP_SYSTEM.LineDrawings[name]:Remove()
        ESP_SYSTEM.LineDrawings[name] = nil
    end
end

function ESP_SYSTEM.ClearAllLines()
    for _, d in pairs(ESP_SYSTEM.LineDrawings) do if d then d:Remove() end end
    ESP_SYSTEM.LineDrawings = {}
end

function ESP_SYSTEM.UpdateCamera() ESP_SYSTEM.Camera = workspace.CurrentCamera end

function ESP_SYSTEM.StopAllLines()
    for _, c in ipairs(lineConnections) do if c then pcall(function() c:Disconnect() end) end end
    lineConnections = {}
    ESP_SYSTEM.ClearAllLines()
end

function ESP_SYSTEM.InitializePlayerLines(tp)
    if not pcall(function() return Drawing.new("Line") end) then
        warn("[mathrus7z] Drawing API not supported."); return nil
    end
    if not ESP_SYSTEM.LineDrawings[tp.Name] then
        local l = Drawing.new("Line")
        l.Visible = false; l.Color = Color3.fromRGB(255, 255, 255)
        l.Thickness = ESP_SYSTEM.ESP_LINE_STATES.LineThickness
        l.Transparency = ESP_SYSTEM.ESP_LINE_STATES.LineTransparency
        ESP_SYSTEM.LineDrawings[tp.Name] = l
    end
    local cr, ca, lrf = nil, false, 0
    return RunService.RenderStepped:Connect(function()
        if not ESP_SYSTEM.ESP_LINE_STATES.ESPLine then
            if ESP_SYSTEM.LineDrawings[tp.Name] then ESP_SYSTEM.LineDrawings[tp.Name].Visible = false end
            return
        end
        ESP_SYSTEM.UpdateCamera()
        if tp and tp.Character and tp.Character:FindFirstChild("Humanoid") and
           tp.Character:FindFirstChild("HumanoidRootPart") and tp.Name ~= player.Name and
           tp.Character.Humanoid.Health > 0 then
            local ct = tick()
            if ct - lrf >= 0.1 then
                local rd = ESP_SYSTEM.GetRolesData()
                local role, alive = ESP_SYSTEM.getPlayerRole(tp, rd)
                cr, ca, lrf = role, alive, ct
            end
            if not ESP_SYSTEM.ShouldShowLine(cr) or not ca then
                if ESP_SYSTEM.LineDrawings[tp.Name] then ESP_SYSTEM.LineDrawings[tp.Name].Visible = false end
                return
            end
            local pp = tp.Character.HumanoidRootPart.Position
            local vp, vis = ESP_SYSTEM.Camera:WorldToViewportPoint(pp)
            if vis then
                local l = ESP_SYSTEM.LineDrawings[tp.Name]
                if l then
                    l.From = Vector2.new(ESP_SYSTEM.Camera.ViewportSize.X/2, ESP_SYSTEM.Camera.ViewportSize.Y/2)
                    l.To = Vector2.new(vp.X, vp.Y)
                    l.Color = ESP_SYSTEM.GetColorByRole(cr, ca)
                    l.Thickness = ESP_SYSTEM.ESP_LINE_STATES.LineThickness
                    l.Transparency = ESP_SYSTEM.ESP_LINE_STATES.LineTransparency
                    l.Visible = true
                end
            else
                if ESP_SYSTEM.LineDrawings[tp.Name] then ESP_SYSTEM.LineDrawings[tp.Name].Visible = false end
            end
        else
            if ESP_SYSTEM.LineDrawings[tp.Name] then ESP_SYSTEM.LineDrawings[tp.Name].Visible = false end
        end
    end)
end

function ESP_SYSTEM.StartAllLines()
    ESP_SYSTEM.StopAllLines()
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp ~= player then
            table.insert(lineConnections, ESP_SYSTEM.InitializePlayerLines(tp))
        end
    end
end

function ESP_SYSTEM.updateBillboard(tp, role, alive)
    if tp == player then return end
    local char = tp.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local bb = hrp:FindFirstChild("mathrus7zBillboard")
    local color
    if role == "Murderer" and alive then color = ESP_SYSTEM.ROLE_COLORS.Murderer
    elseif role == "Sheriff" and alive then color = ESP_SYSTEM.ROLE_COLORS.Sheriff
    elseif role == "Hero" and alive then color = ESP_SYSTEM.ROLE_COLORS.Hero
    elseif role == "Innocent" and alive then color = ESP_SYSTEM.ROLE_COLORS.Innocent
    else color = Color3.fromRGB(255, 255, 255) end
    if bb then
        local tl = bb:FindFirstChild("PlayerName")
        if tl then tl.TextColor3 = color; tl.Text = tp.Name end
    else
        bb = Instance.new("BillboardGui")
        bb.Name = "mathrus7zBillboard"; bb.Adornee = hrp; bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 100, 0, 30); bb.StudsOffset = Vector3.new(0, 2.5, 0); bb.ResetOnSpawn = false
        local tl = Instance.new("TextLabel")
        tl.Name = "PlayerName"; tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1
        tl.Text = tp.Name; tl.TextColor3 = color; tl.Font = Enum.Font.GothamBold
        tl.TextSize = 14; tl.TextStrokeTransparency = 0.5; tl.TextStrokeColor3 = Color3.new(0, 0, 0)
        tl.Parent = bb; bb.Parent = hrp
        ESP_SYSTEM.billboards[tp] = bb
    end
end

function ESP_SYSTEM.removeBillboard(tp)
    if tp == player then return end
    if ESP_SYSTEM.billboards[tp] then ESP_SYSTEM.billboards[tp]:Destroy(); ESP_SYSTEM.billboards[tp] = nil end
    local char = tp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bb = hrp:FindFirstChild("mathrus7zBillboard")
            if bb then bb:Destroy() end
        end
    end
end

function ESP_SYSTEM.clearAllESP()
    for _, bb in pairs(ESP_SYSTEM.billboards) do if bb and bb.Parent then bb:Destroy() end end
    ESP_SYSTEM.billboards = {}
end

function ESP_SYSTEM.updateHighlight(tp, role, alive)
    if tp == player then return end
    local char = tp.Character; if not char then return end
    local hl = char:FindFirstChild("mathrus7zHighlight")
    if not hl or not hl:IsA("Highlight") then
        if hl then hl:Destroy() end
        hl = Instance.new("Highlight")
        hl.Name = "mathrus7zHighlight"; hl.Adornee = char
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.7; hl.OutlineTransparency = 0.4
        hl.OutlineColor = Color3.new(1, 1, 1); hl.Parent = char
    end
    local color
    if role == "Murderer" and alive then color = Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" and alive then color = Color3.fromRGB(0, 0, 255)
    elseif role == "Hero" and alive then color = Color3.fromRGB(255, 255, 0)
    elseif role == "Innocent" and alive then color = Color3.fromRGB(0, 255, 0)
    else color = Color3.fromRGB(255, 255, 255) end
    hl.FillColor = color
end

function ESP_SYSTEM.removeHighlight(tp)
    if tp == player then return end
    local char = tp.Character
    if char then
        local hl = char:FindFirstChild("mathrus7zHighlight")
        if hl and hl:IsA("Highlight") then hl:Destroy() end
    end
end

function ESP_SYSTEM.clearAllHighlights()
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp ~= player then ESP_SYSTEM.removeHighlight(tp) end
    end
end

function ESP_SYSTEM.updateESP()
    if not ESP_SYSTEM.ESP_STATES.ESPName then ESP_SYSTEM.clearAllESP(); return end
    local rd = ESP_SYSTEM.GetRolesData()
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp == player then continue end
        local char = tp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hrp then ESP_SYSTEM.removeBillboard(tp); continue end
        if not ESP_SYSTEM.IsPlayerOnScreen(tp) then ESP_SYSTEM.removeBillboard(tp); continue end
        local role, alive = ESP_SYSTEM.getPlayerRole(tp, rd)
        local show = false
        if role == "Murderer" and ESP_SYSTEM.ESP_STATES.MurdererName then show = true
        elseif role == "Sheriff" and ESP_SYSTEM.ESP_STATES.SheriffName then show = true
        elseif role == "Hero" and ESP_SYSTEM.ESP_STATES.HeroName then show = true
        elseif role == "Innocent" and ESP_SYSTEM.ESP_STATES.InnocentName then show = true
        elseif not role then show = true end
        if show then ESP_SYSTEM.updateBillboard(tp, role, alive)
        else ESP_SYSTEM.removeBillboard(tp) end
    end
end

function ESP_SYSTEM.updateHighlights()
    if not ESP_SYSTEM.ESP_HIGHLIGHT_STATES.ESPHighlight then ESP_SYSTEM.clearAllHighlights(); return end
    local rd = ESP_SYSTEM.GetRolesData()
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp == player then continue end
        local char = tp.Character
        if not char then ESP_SYSTEM.removeHighlight(tp); continue end
        if not ESP_SYSTEM.IsPlayerOnScreen(tp) then ESP_SYSTEM.removeHighlight(tp); continue end
        local role, alive = ESP_SYSTEM.getPlayerRole(tp, rd)
        local show = false
        if role == "Murderer" and ESP_SYSTEM.ESP_HIGHLIGHT_STATES.ESPHighlightMurderer then show = true
        elseif role == "Sheriff" and ESP_SYSTEM.ESP_HIGHLIGHT_STATES.ESPHighlightSheriff then show = true
        elseif role == "Hero" and ESP_SYSTEM.ESP_HIGHLIGHT_STATES.ESPHighlightHero then show = true
        elseif role == "Innocent" and ESP_SYSTEM.ESP_HIGHLIGHT_STATES.ESPHighlightInnocent then show = true end
        if show then ESP_SYSTEM.updateHighlight(tp, role, alive)
        else ESP_SYSTEM.removeHighlight(tp) end
    end
end

function ESP_SYSTEM.initializePlayer(tp)
    if tp == player then return end
    tp.CharacterAdded:Connect(function() task.wait(0.5); ESP_SYSTEM.updateESP() end)
    tp.CharacterRemoving:Connect(function()
        ESP_SYSTEM.removeBillboard(tp); ESP_SYSTEM.removeHighlight(tp)
    end)
    if tp.Character then task.spawn(function() task.wait(0.5); ESP_SYSTEM.updateESP() end) end
end

-- ═══════════════════════════════════════════════
-- ANTI-FLING
-- ═══════════════════════════════════════════════
local ANTI_FLING = {}

function ANTI_FLING.enable()
    if STATES.AntiFling.Enabled then return end
    STATES.AntiFling.Enabled = true
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    local function disableAll()
        for _, tp in ipairs(Players:GetPlayers()) do
            if tp ~= player and tp.Character then
                for _, p in ipairs(tp.Character:GetDescendants()) do
                    if p:IsA("BasePart") and not p.Anchored then p.CanCollide = false end
                end
            end
        end
    end
    disableAll()
    local t1 = task.spawn(function()
        while STATES.AntiFling.Enabled do
            task.wait(0.3)
            if not char or char.Parent == nil then
                char = player.Character
                if char then
                    hum = char:FindFirstChild("Humanoid")
                    if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end
                end
            end
            disableAll()
        end
    end)
    local c1 = Players.PlayerAdded:Connect(function(tp)
        if tp ~= player then
            tp.CharacterAdded:Connect(function(c)
                task.wait(0.2)
                if STATES.AntiFling.Enabled then
                    for _, p in ipairs(c:GetDescendants()) do
                        if p:IsA("BasePart") and not p.Anchored then p.CanCollide = false end
                    end
                end
            end)
        end
    end)
    local c2 = player.CharacterAdded:Connect(function(nc)
        char = nc; hum = char:FindFirstChild("Humanoid")
        if hum and STATES.AntiFling.Enabled then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end
        task.wait(0.2)
        if STATES.AntiFling.Enabled then disableAll() end
    end)
    STATES.AntiFling.Connections = { task = t1, playerAdded = c1, characterAdded = c2 }
end

function ANTI_FLING.disable()
    if not STATES.AntiFling.Enabled then return end
    STATES.AntiFling.Enabled = false
    local c = STATES.AntiFling.Connections
    if c then
        if c.task then task.cancel(c.task) end
        if c.playerAdded then c.playerAdded:Disconnect() end
        if c.characterAdded then c.characterAdded:Disconnect() end
    end
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp ~= player and tp.Character then
            for _, p in ipairs(tp.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end
    local char = player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end
    end
    STATES.AntiFling.Connections = nil
end

local function toggleMuteRadio(v)
    STATES.MuteRadio.Enabled = v
    for _, o in pairs(workspace:GetDescendants()) do
        if o:IsA("Sound") and o.Name == "RadioSound" then o.Volume = v and 0 or 1 end
    end
    if v then
        if not STATES.MuteRadio.Connection then
            STATES.MuteRadio.Connection = workspace.DescendantAdded:Connect(function(d)
                if STATES.MuteRadio.Enabled and d:IsA("Sound") and d.Name == "RadioSound" then d.Volume = 0 end
            end)
        end
    else
        if STATES.MuteRadio.Connection then STATES.MuteRadio.Connection:Disconnect(); STATES.MuteRadio.Connection = nil end
    end
end

-- ═══════════════════════════════════════════════
-- FARMING
-- ═══════════════════════════════════════════════
local FARMING = {}

function FARMING.getNearestCoin()
    local root = UTILS.getHRP(); if not root then return nil, math.huge end
    local nc, nd = nil, math.huge
    for _, o in ipairs(workspace:GetChildren()) do
        if o:FindFirstChild("CoinContainer") then
            for _, coin in ipairs(o.CoinContainer:GetChildren()) do
                if coin:IsA("BasePart") and coin:GetAttribute("CoinID") == "Coin" and coin:FindFirstChild("TouchInterest") then
                    local d = (root.Position - coin.Position).Magnitude
                    if d < nd then nd = d; nc = coin end
                end
            end
        end
    end
    return nc, nd
end

function FARMING.startLoop()
    task.spawn(function()
        while true do
            local wt = 0.1
            if STATES.AutoFarm.Enabled and STATES.AutoFarm.Farming and not STATES.AutoFarm.BagFull then
                local coin, dist = FARMING.getNearestCoin()
                local hrp = UTILS.getHRP()
                if coin and hrp then
                    if dist > 150 then hrp.CFrame = coin.CFrame
                    else
                        local t = TweenService:Create(hrp, TweenInfo.new(dist / 25, Enum.EasingStyle.Linear), {CFrame = coin.CFrame})
                        t:Play()
                        local st = tick()
                        repeat task.wait() until not coin:FindFirstChild("TouchInterest") or not STATES.AutoFarm.Farming or not STATES.AutoFarm.Enabled or tick() - st > 5
                        if t then t:Cancel() end
                    end
                end
            elseif STATES.AutoFarm.Enabled then wt = 0.5
            else wt = 1 end
            task.wait(wt)
        end
    end)
end

function FARMING.autoReset()
    if STATES.AutoFarm.Enabled and STATES.AutoFarm.BagFull and not STATES.AutoFarm.Resetting then
        STATES.AutoFarm.Resetting = true
        local hrp = UTILS.getHRP()
        if hrp and STATES.AutoFarm.StartPosition then
            local t = TweenService:Create(hrp, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = STATES.AutoFarm.StartPosition})
            t:Play(); t.Completed:Wait()
        end
        task.wait(0.5)
        if player.Character and player.Character:FindFirstChild("Humanoid") then player.Character.Humanoid.Health = 0 end
        player.CharacterAdded:Wait(); task.wait(1.5)
        STATES.AutoFarm.Resetting = false
        STATES.AutoFarm.BagFull = false
    end
end

