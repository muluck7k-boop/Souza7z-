function UTILS.createInstance(cls, parent, props)
    local o = Instance.new(cls, parent)
    for k, v in pairs(props) do o[k] = v end
    return o
end

function UTILS.getHRP()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return player.Character.HumanoidRootPart
    end
    return nil
end

function UTILS.addSpacer(parent, y, h)
    return UTILS.createInstance("Frame", parent, {
        Name = "Spacer", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, h), Position = UDim2.new(0, 0, 0, y)
