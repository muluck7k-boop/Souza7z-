-- Script Luau para Roblox
-- Cria uma tela cinza escuro cobrindo toda a tela com texto centralizado.

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remove tela anterior, se existir (evita duplicatas)
local existing = playerGui:FindFirstChild("ScriptFechadoGui")
if existing then
	existing:Destroy()
end

-- Cria o ScreenGui principal
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ScriptFechadoGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

-- Frame de fundo cinza escuro ocupando 100% da tela
local fundo = Instance.new("Frame")
fundo.Name = "Fundo"
fundo.Size = UDim2.new(1, 0, 1, 0)
fundo.Position = UDim2.new(0, 0, 0, 0)
fundo.BackgroundColor3 = Color3.fromRGB(45, 45, 45) -- cinza escuro
fundo.BorderSizePixel = 0
fundo.BackgroundTransparency = 0
fundo.Parent = screenGui

-- Texto centralizado
local texto = Instance.new("TextLabel")
texto.Name = "Mensagem"
texto.Size = UDim2.new(1, 0, 1, 0)
texto.Position = UDim2.new(0, 0, 0, 0)
texto.BackgroundTransparency = 1
texto.Text = "Script fechado por matheus7z"
texto.TextColor3 = Color3.fromRGB(255, 255, 255)
texto.TextScaled = true
texto.Font = Enum.Font.GothamBold -- fonte moderna/negrito
texto.TextWrapped = true
texto.TextXAlignment = Enum.TextXAlignment.Center
texto.TextYAlignment = Enum.TextYAlignment.Center
texto.Parent = fundo

-- Ajusta o tamanho máximo do texto para não estourar em telas muito largas
texto.TextSize = 60
texto.TextScaled = false

-- Atualiza dinamicamente para caber bem na tela
local function ajustarTamanho()
	local viewport = workspace.CurrentCamera.ViewportSize
	local tamanho = math.clamp(viewport.Y * 0.08, 24, 120)
	texto.TextSize = tamanho
end

ajustarTamanho()

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(ajustarTamanho)
end

print("[ScriptFechadoGui] Tela exibida com sucesso.")
